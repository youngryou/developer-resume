---
import Layout from "../layouts/Layout.astro";

const currentFiles = import.meta.glob("../data/cover-letters/current.md", {
  eager: true,
});
const currentFileKey = "../data/cover-letters/current.md";

const targetLetter = currentFiles[currentFileKey]
  ? (currentFiles[currentFileKey] as any)
  : await import("../data/cover-letter-sample.md");

const { frontmatter, Content } = targetLetter;

const email = import.meta.env.SECRET_EMAIL || "ry****@gmail.com";
const phone = import.meta.env.SECRET_PHONE || "021-****-****";

const github =
  frontmatter.github ||
  import.meta.env.SECRET_GITHUB ||
  "https://github.com/youngryou";
const linkedin =
  frontmatter.linkedin ||
  import.meta.env.SECRET_LINKEDIN ||
  "https://linkedin.com/in/young-ryou";
const portfolio =
  frontmatter.portfolio ||
  import.meta.env.SECRET_PORTFOLIO ||
  "https://youngryou.com";
---

<Layout title={`Cover Letter - ${frontmatter.name} | ${frontmatter.company}`}>
  <main
    class="max-w-[210mm] w-full mx-auto bg-white p-8 sm:p-14 shadow-lg my-10 print:max-w-none print:w-[210mm] print:shadow-none print:my-0 print:p-0"
  >
    <header class="mb-10 border-b border-slate-200 pb-8 print:border-slate-300">
      <div
        class="flex flex-col md:flex-row md:justify-between md:items-start print:flex-row print:justify-between gap-6 mb-8"
      >
        <div>
          <div class="flex items-center gap-4 flex-wrap">
            <h1
              class="text-3xl font-black text-sky-700 uppercase tracking-wider"
            >
              {frontmatter.name}
            </h1>
            <span class="text-md font-black text-slate-700 tracking-tight">
              {frontmatter.role}
            </span>
          </div>

          <div
            class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs font-bold text-slate-500 print:text-slate-700 uppercase tracking-wider"
          >
            <span>{frontmatter.location}</span>
            <span
              class="hidden md:inline print:inline text-sky-200 print:text-slate-300"
              >|</span
            >
            <span>{email}</span>
            <span
              class="hidden md:inline print:inline text-sky-200 print:text-slate-300"
              >|</span
            >
            <span>{phone}</span>
          </div>
        </div>

        <div class="text-left md:text-right print:text-right">
          <span
            class="inline-block px-3 py-1.5 bg-slate-50 text-slate-600 border border-slate-200 rounded-md text-xs font-bold"
          >
            {frontmatter.date}
          </span>
        </div>
      </div>

      <div class="border-l-4 border-sky-700 pl-4 py-1">
        <p
          class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1 print:text-slate-600"
        >
          Application For
        </p>
        <p class="text-xl font-black text-slate-800 tracking-tight">
          {frontmatter.position}
        </p>
        <p class="text-sm font-bold text-sky-700 mt-1">
          @ {frontmatter.company}
        </p>
      </div>
    </header>

    <article
      class="prose px-4 max-w-none text-slate-700 print:text-slate-900 leading-relaxed"
    >
      <Content />
    </article>

    <footer class="mt-14 pt-8 border-t border-slate-200 print:border-slate-300">
      <div
        class="flex justify-center items-center text-slate-500 text-xs font-bold uppercase tracking-wider"
      >
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-sky-700 print:text-slate-700 transition-colors"
          >
            Github <span
              class="hidden print:inline text-[10px] font-normal lowercase"
            >
              ({github.replace(/^https?:\/\//, "")})</span
            >
          </a>

          <span class="text-sky-200 print:text-slate-300">|</span>

          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-sky-700 print:text-slate-700 transition-colors"
          >
            LinkedIn <span
              class="hidden print:inline text-[10px] font-normal lowercase"
            >
              ({linkedin.replace(/^https?:\/\//, "")})</span
            >
          </a>

          <span class="text-sky-200 print:text-slate-300">|</span>

          <a
            href={portfolio}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-sky-700 print:text-slate-700 transition-colors"
          >
            Portfolio <span
              class="hidden print:inline text-[10px] font-normal lowercase"
            >
              ({portfolio.replace(/^https?:\/\//, "")})</span
            >
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
