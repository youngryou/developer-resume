---
const pathname = Astro.url.pathname;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const isCV = pathname === basePath || pathname === `${basePath}/`;
const isCover = pathname.startsWith(`${basePath}/cover`);
---

<nav class="print:hidden fixed top-6 left-6 z-50 flex gap-3">
  <a
    href={`${basePath}/`}
    class={`px-5 py-2.5 rounded-lg text-sm font-medium transition-all shadow-md ${
      isCV
        ? "bg-gray-900 text-white"
        : "bg-white text-gray-900 hover:bg-gray-700 hover:text-white"
    }`}
  >
    CV
  </a>
  <a
    href={`${basePath}/cover`}
    class={`px-5 py-2.5 rounded-lg text-sm font-medium transition-all shadow-md ${
      isCover
        ? "bg-gray-900 text-white"
        : "bg-white text-gray-900 hover:bg-gray-700 hover:text-white"
    }`}
  >
    Cover Letter
  </a>
</nav>
