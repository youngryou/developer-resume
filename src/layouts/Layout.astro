---
const { title } = Astro.props;
import PrintButton from "../components/PrintButton.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body
    class="bg-[linear-gradient(170deg,#0369a1_25%,#f3f4f6_25%,#f3f4f6_75%,#0369a1_75%)] min-h-screen
           text-gray-900 font-sans print:bg-white print:text-black selection:bg-gray-200"
  >
    <PrintButton />
    <slot />
  </body>
</html>

<style is:global>
  @reference "tailwindcss";

  .prose h1 {
    @apply text-xl font-bold mt-10 mb-4 uppercase tracking-wider text-sky-700
           border-b border-slate-200 pb-1.5
           pl-3 border-l-4 border-l-sky-700;
  }
  .prose h2 {
    @apply text-lg font-semibold text-sky-700 mb-1 flex justify-between items-end;
  }
  .prose h3 {
    @apply text-base font-medium mt-3 mb-2 text-gray-800;
  }
  .prose p {
    @apply mb-2 text-gray-600 print:text-gray-800 text-sm md:text-base;
  }
  .prose ul {
    @apply list-inside space-y-1 mb-2 text-gray-600 print:text-gray-800 text-sm md:text-base;
  }
  .prose a {
    @apply hover:underline print:no-underline;
  }
  .prose strong {
    @apply font-semibold text-gray-900;
  }
  .prose code {
    @apply inline-block px-2 py-0.5 mx-0.5 my-0.5 
    bg-sky-700 text-white rounded text-sm font-bold tracking-wide;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  @page {
    margin: 10mm 15mm;
  }
</style>
