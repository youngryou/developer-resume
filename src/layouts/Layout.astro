---
const { title } = Astro.props;
import { ClientRouter } from "astro:transitions";

import PrintButton from "../components/PrintButton.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

const basePath =
  import.meta.env.BASE_URL === "/"
    ? ""
    : import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}/favicon.svg`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class="bg-[linear-gradient(170deg,#0369a1_25%,#f3f4f6_25%,#f3f4f6_75%,#0369a1_75%)] min-h-screen
           text-gray-900 font-sans print:bg-white print:text-black selection:bg-gray-200"
  >
    <Navigation />
    <PrintButton />
    <slot />
  </body>
</html>

<style is:global>
  @reference "tailwindcss";

  .prose h1 {
    @apply text-xl font-bold mt-8 mb-4 uppercase tracking-wider text-sky-700
           border-b border-slate-200 pb-1.5
           pl-3 border-l-4 border-l-sky-700;
  }
  .prose h2 {
    @apply text-lg font-semibold text-sky-700 mb-1 flex justify-between items-end;
  }
  .prose h3 {
    @apply text-base font-semibold text-gray-700 mb-1 flex justify-between items-end;
  }
  .prose h4 {
    @apply text-sm font-semibold text-gray-700 mb-1 flex justify-between items-end;
  }
  .prose p {
    @apply mb-2 text-gray-600 print:text-gray-800 text-sm;
  }
  .prose ul {
    @apply list-inside space-y-1 mb-1 text-gray-600 print:text-gray-800 text-sm;
  }
  .prose a {
    @apply text-sky-700 hover:underline print:no-underline;
  }
  .prose strong {
    @apply font-semibold text-gray-700;
  }
  .prose hr {
    @apply border-t border-slate-100 my-2;
  }
  .prose code {
    @apply inline-block px-1.5 mx-0.5 my-0.5 
    bg-gray-300 text-gray-800 rounded-sm text-sm;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .prose li code {
    @apply mx-0 px-2 py-0.5 bg-sky-700 text-white rounded-md text-xs font-bold tracking-wide;
  }
  .prose .entry-header {
    @apply flex flex-col sm:flex-row sm:justify-between sm:items-baseline
    print:flex-row print:justify-between print:items-baseline;
  }
  .prose .entry-location {
    @apply my-auto ml-2;
  }
  .prose .entry-date {
    @apply text-sm font-semibold text-gray-700;
  }

  @page {
    margin: 10mm 15mm;
  }
</style>
